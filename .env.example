# DoctorAgent environment configuration template.
# Copy to `.env` and edit. `.env` is git-ignored; never commit real secrets.
# Pydantic-settings loads this automatically (env_prefix=DOCTORAGENT_, nested delim=__).

# ── Runtime profile ──────────────────────────────────────────────────────────
# dev  : permissive (debug logs, relaxed timeouts)  [default]
# staging : production-like but non-fatal warnings
# prod : strict — fails fast on missing secrets / insecure defaults
DOCTORAGENT_ENV=dev
DOCTORAGENT_DEBUG=false
DOCTORAGENT_APP_NAME=DoctorAgent

# Device discovery (mDNS) — off by default; opt in only for multi-device sync.
DOCTORAGENT_DISCOVERY_ENABLED=false

# ── LLM provider ─────────────────────────────────────────────────────────────
# Default to a local Ollama endpoint. Any OpenAI-compatible /v1 endpoint works.
DOCTORAGENT_MODEL__BASE_URL=http://127.0.0.1:11434/v1
DOCTORAGENT_MODEL__MODEL_NAME=qwen3:8b
DOCTORAGENT_MODEL__CTX_SIZE=32768
DOCTORAGENT_MODEL__TEMPERATURE=0.3
DOCTORAGENT_MODEL__TIMEOUT=120.0
# Failover model used when the primary is unreachable (provider fallback chain).
DOCTORAGENT_MODEL__FALLBACK_MODEL_NAME=

# ── Security ─────────────────────────────────────────────────────────────────
# Master key provider: FilePassword | DPAPI | TPM | mac-keychain
DOCTORAGENT_SECURITY__MASTER_KEY_PROVIDER=FilePassword
# Required for FilePassword provider; never persisted to settings.json.
# No weak default: docker-compose now fails closed (${VAR:?...}) when this is
# unset, and the FilePassword provider also raises at runtime if it is empty.
# Set a strong value here before ingesting any real data; rotating it later
# re-encrypts the entire vault.
DOCTORAGENT_SECURITY__MASTER_KEY_PASSWORD=
DOCTORAGENT_SECURITY__KDF=Argon2id
DOCTORAGENT_SECURITY__ENCRYPTION=AES-256-GCM
DOCTORAGENT_SECURITY__WINDOWS_HELLO_ENABLED=false
DOCTORAGENT_SECURITY__ENABLE_SEMANTIC_SEARCH=false
DOCTORAGENT_SECURITY__SEMANTIC_MODEL=all-MiniLM-L6-v2
# ── RAG 向量后端（v0.3.18+）─────────────────────────────────────────
# sqlite = 内联稠密路径（默认，向量存 vault_chunks）；chroma = 双写外部 ANN 存储
# （需 pip install chromadb）。SQLite 始终是元数据/正文的事实源，外部后端只做检索。
# 跨租户隔离：检索时按租户行回查过滤，后端中的外租户命中会被丢弃。
DOCTORAGENT_RAG_VECTOR_BACKEND=sqlite
# 留空则默认 <index>/vectorstore
DOCTORAGENT_RAG_VECTOR_BACKEND_PATH=
# Embedding 后端：local（进程内 sentence-transformers）或 openai（任意 OpenAI 兼容 /v1/embeddings 服务）
# 推荐：TEI (huggingface/text-embeddings-inference)、Ollama、Infinity；医学多语场景建议 BAAI/bge-m3
DOCTORAGENT_SECURITY__SEMANTIC_BACKEND=local
DOCTORAGENT_SECURITY__SEMANTIC_EMBEDDING_BASE_URL=
DOCTORAGENT_SECURITY__SEMANTIC_EMBEDDING_MODEL=
DOCTORAGENT_SECURITY__SEMANTIC_EMBEDDING_API_KEY=
DOCTORAGENT_SECURITY__CLOUD_FALLBACK_ENABLED=false
# Redact path fields in audit log to basenames (comma-separated list of paths).
DOCTORAGENT_SECURITY__AUDIT_REDACT_PATHS=[]
DOCTORAGENT_SECURITY__ENABLE_FIELD_ENCRYPTION=false
DOCTORAGENT_SECURITY__ENABLE_SANDBOX=false
# Outbound alert webhook (HMAC-signed POSTs for CRITICAL/WARNING events).
DOCTORAGENT_SECURITY__ALERT_WEBHOOK_URL=
DOCTORAGENT_SECURITY__ALERT_WEBHOOK_SECRET=

# ── Automatic key rotation ────────────────────────────────────────────────────
DOCTORAGENT_AUTO_KEY_ROTATION__ENABLED=false
DOCTORAGENT_AUTO_KEY_ROTATION__ROTATION_INTERVAL_DAYS=90
DOCTORAGENT_AUTO_KEY_ROTATION__GRACE_PERIOD_DAYS=7
DOCTORAGENT_AUTO_KEY_ROTATION__AUTO_ROTATE_ON_FAILURES_THRESHOLD=5
DOCTORAGENT_AUTO_KEY_ROTATION__CHECK_INTERVAL_SECONDS=3600.0

# ── GDPR / CCPA compliance ───────────────────────────────────────────────────
DOCTORAGENT_COMPLIANCE__ENABLE_AUTO_EXPIRY=false
DOCTORAGENT_COMPLIANCE__RETENTION_POLICIES={}
DOCTORAGENT_COMPLIANCE__AUTO_DELETE_EXPIRED=false

# ── Paths ────────────────────────────────────────────────────────────────────
DOCTORAGENT_PATHS__INBOX=
DOCTORAGENT_PATHS__VAULT=
DOCTORAGENT_PATHS__INDEX=
DOCTORAGENT_PATHS__LOGS=
DOCTORAGENT_PATHS__CONNECTIONS=
DOCTORAGENT_PATHS__SETTINGS=

# ── Resource limits & backpressure ──────────────────────────────────────────
DOCTORAGENT_RESOURCES__MAX_INFLIGHT_FILES=8
DOCTORAGENT_RESOURCES__CLASSIFY_CONCURRENCY=4
DOCTORAGENT_RESOURCES__INBOX_BACKLOG_HIGH_WATERMARK=1000
DOCTORAGENT_RESOURCES__INBOX_BACKLOG_LOW_WATERMARK=800
DOCTORAGENT_RESOURCES__DISK_WATERMARK_PERCENT=90.0

# ── Integrations ─────────────────────────────────────────────────────────────
DOCTORAGENT_INTEGRATIONS__WEBHOOKS_ENABLED=false
DOCTORAGENT_INTEGRATIONS__WEBHOOK_ENDPOINTS=[]
DOCTORAGENT_INTEGRATIONS__WEBHOOK_DEFAULT_SECRET=
DOCTORAGENT_INTEGRATIONS__WEBHOOK_MAX_RETRIES=3
DOCTORAGENT_INTEGRATIONS__WEBHOOK_TIMEOUT_SECONDS=10.0
DOCTORAGENT_INTEGRATIONS__STORAGE_ENABLED=false
# storage_backup_backend: local | s3 | webdav
DOCTORAGENT_INTEGRATIONS__STORAGE_BACKUP_BACKEND=local
# S3 / MinIO
DOCTORAGENT_INTEGRATIONS__S3_ENDPOINT=
DOCTORAGENT_INTEGRATIONS__S3_REGION=us-east-1
DOCTORAGENT_INTEGRATIONS__S3_BUCKET=
DOCTORAGENT_INTEGRATIONS__S3_ACCESS_KEY=
DOCTORAGENT_INTEGRATIONS__S3_SECRET_KEY=
DOCTORAGENT_INTEGRATIONS__S3_USE_PATH_STYLE=true
# WebDAV
DOCTORAGENT_INTEGRATIONS__WEBDAV_URL=
DOCTORAGENT_INTEGRATIONS__WEBDAV_USERNAME=
DOCTORAGENT_INTEGRATIONS__WEBDAV_PASSWORD=
DOCTORAGENT_INTEGRATIONS__STORAGE_KEY_PREFIX=doctoragent/

# ── Hooks ────────────────────────────────────────────────────────────────────
DOCTORAGENT_HOOKS__PRE_CONSUME_HOOKS=[]
DOCTORAGENT_HOOKS__POST_CONSUME_HOOKS=[]

# ── API server ───────────────────────────────────────────────────────────────
# Bearer token for REST/WS auth. Empty = auth disabled (local dev only).
# In prod this MUST be set; the server refuses to start otherwise.
DOCTORAGENT_API_TOKEN=

# ── Cloud KMS (optional, security/kms.py) ────────────────────────────────────
# Provider: aws | azure | gcp | none
DOCTORAGENT_KMS_PROVIDER=none
# AWS KMS
DOCTORAGENT_KMS_AWS_KEY_ID=
DOCTORAGENT_KMS_AWS_REGION=us-east-1
# Azure Key Vault
DOCTORAGENT_KMS_AZURE_VAULT_URL=
DOCTORAGENT_KMS_AZURE_KEY_NAME=
# GCP KMS
DOCTORAGENT_KMS_GCP_KEY_RING=
DOCTORAGENT_KMS_GCP_KEY_NAME=
DOCTORAGENT_KMS_GCP_PROJECT=

# ── Observability ────────────────────────────────────────────────────────────
# OTel exporter endpoint (OTLP). Empty = tracing disabled.
DOCTORAGENT_OTEL_EXPORTER_OTLP_ENDPOINT=
DOCTORAGENT_OTEL_SERVICE_NAME=doctoragent
# Prometheus /metrics endpoint enabled when server extra is installed.
DOCTORAGENT_METRICS_ENABLED=true

# ── Clinical decision support ───────────────────────────────────────────────
# FHIR R4 server. Empty (default) → /clinical/analyze runs on the
# patient_context in the request body (or synthetic fixtures). Set to a real
# FHIR endpoint (e.g. http://hapi-fhir:8080/fhir for the compose `with-fhir`
# profile) to enable live FHIR reads via FHIRClient.
DOCTORAGENT_CLINICAL__FHIR_BASE_URL=
# Bearer token for the FHIR server (SMART access_token or static API key).
# Leave empty for unauthenticated FHIR servers (e.g. public HAPI / dev HAPI).
DOCTORAGENT_CLINICAL__FHIR_AUTH_TOKEN=
DOCTORAGENT_CLINICAL__FHIR_TIMEOUT_SECONDS=30.0
# SMART-on-FHIR launch issuer / client credentials. When smart_issuer is set
# the SMART launch flow (smart.py) can discover OAuth endpoints and run a
# standalone launch. Leave empty to skip SMART (use static fhir_auth_token).
DOCTORAGENT_CLINICAL__SMART_ISSUER=
DOCTORAGENT_CLINICAL__SMART_CLIENT_ID=
DOCTORAGENT_CLINICAL__SMART_CLIENT_SECRET=
# Knowledge sources — defaults point at public NLM/FDA/NCBI endpoints.
# Override only for on-premise mirrors or air-gapped deployments.
DOCTORAGENT_CLINICAL__OPENFDA_BASE_URL=https://api.fda.gov
DOCTORAGENT_CLINICAL__RXNORM_BASE_URL=https://rxnorm.nlm.nih.gov
DOCTORAGENT_CLINICAL__PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
# SNOMED CT terminology server (Snowstorm). Public default is rate-limited.
DOCTORAGENT_CLINICAL__SNOWSTORM_BASE_URL=https://browser.ihtsdotools.org/snowstorm/snomedct
# Optional bulk ICD-10 / LOINC table paths (CSV/TSV). Empty → curated maps.
DOCTORAGENT_CLINICAL__ICD10_TABLE_PATH=
DOCTORAGENT_CLINICAL__LOINC_TABLE_PATH=

# ── A2A (Agent-to-Agent) 协议 ────────────────────────────────────────
# 默认关闭（安全默认）：显式设为 true 才对外暴露 A2A 任务端点
DOCTORAGENT_A2A__ENABLED=false
DOCTORAGENT_A2A__AGENT_NAME=DoctorAgent
DOCTORAGENT_A2A__BASE_URL=http://127.0.0.1:8000
# 可委派子任务的远端 Agent base URL 列表（逗号分隔）
DOCTORAGENT_A2A__PEER_AGENTS=

# ── 语音对话（ASR + TTS，OpenAI 兼容端点）──────────────────────────
DOCTORAGENT_VOICE__ENABLED=true
DOCTORAGENT_VOICE__TRANSCRIBE_BASE_URL=
DOCTORAGENT_VOICE__TRANSCRIBE_MODEL=
DOCTORAGENT_VOICE__TRANSCRIBE_API_KEY=
DOCTORAGENT_VOICE__TTS_BASE_URL=
DOCTORAGENT_VOICE__TTS_MODEL=
DOCTORAGENT_VOICE__TTS_VOICE=alloy
DOCTORAGENT_VOICE__TTS_API_KEY=

# ── 外部 MCP 服务器（启动时导入工具）──────────────────────────────
# JSON 数组，每项 {name, transport: stdio|http, command, args[], url, prefix}
DOCTORAGENT_INTEGRATIONS__MCP_SERVERS=[]

# ── 模型价格表覆盖（M21，JSON，可选）──────────────────────────────
# 例: {"deepseek-v3": {"input": 0.00027, "output": 0.00110, "context": 64000}}
DOCTORAGENT_PRICING__MODEL_PRICES={}
